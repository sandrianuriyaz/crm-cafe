generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// model contoh untuk verifikasi koneksi
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// ── Auth & Account ──────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

// Akun login (customer & admin). Satu User customer terhubung ke satu Member
// (relasi 1:1 opsional). Admin tidak perlu Member.
model User {
  id           String   @id @default(cuid())
  name         String
  // Nullable: user yang daftar lewat OTP (phone) tidak punya email/password.
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member Member?

  @@map("users")
}

// Kode OTP login/registrasi via WhatsApp/SMS. Kode plain tidak disimpan
// (hanya bcrypt hash). Satu nomor bisa punya banyak baris historis; yang aktif =
// consumedAt null & expiresAt > now. Lihat OtpService.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String // kanonik 08xxxxxxxxxx
  codeHash   String
  channel    String // whatsapp | sms
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("otp_codes")
}

// Tier keanggotaan (opsional, dipakai nanti untuk benefit per level poin).
model Tier {
  id        String   @id @default(cuid())
  name      String   @unique
  minPoints Int      @default(0)
  benefits  String?
  createdAt DateTime @default(now())

  members Member[]

  @@map("tiers")
}

// ── Integrasi POS Fase 1 (transaction.completed → CRM) ──────────────────────
// Lihat docs/integrasi-crm.md. CRM = source of truth saldo poin.

// Pelanggan CRM. Member (punya customer.id dari POS) maupun walk-in yang
// diidentifikasi via phone. Walk-in benar-benar anonim (id+phone null) TIDAK
// dibuatkan baris di sini — transaksinya tetap dicatat tanpa member (lihat §11 #4).
model Member {
  id                 String   @id @default(cuid())
  memberCode         String   @unique
  // customer.id dari POS dipakai sebagai external key (§11 #5).
  externalCustomerId String?  @unique
  name               String?
  phone              String?  @unique
  pointBalance       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Akun login pemilik member (null = member dari POS yang belum punya akun /
  // belum diklaim lewat register by phone). Lihat alur klaim member.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id])

  transactions   Transaction[]
  pointHistories PointHistory[]
  vouchers       Voucher[]
  redeems        Redeem[]

  @@map("members")
}

model Transaction {
  id             String  @id @default(cuid())
  // transaction.order_id dari POS; idempotency_key = order_id (§6).
  posOrderId     String? @unique
  posOrderNumber String?
  idempotencyKey String  @unique
  // event_id beda tiap retry — disimpan untuk audit, bukan kunci dedup.
  eventId        String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  storeId  String?
  branchId String?

  orderType String?
  status    String?
  cashierId String?
  currency  String? @default("IDR")

  subtotal             Int     @default(0)
  discountTotal        Int     @default(0)
  taxTotal             Int     @default(0)
  taxInclusive         Boolean @default(true)
  grandTotal           Int
  paymentMethod        String?
  pointsUsed           Int     @default(0)
  pointsDiscountRupiah Int     @default(0)

  // Poin yang di-award CRM untuk transaksi ini (earning).
  pointsAwarded Int @default(0)

  occurredAt DateTime?
  // Payload §4 mentah, disimpan apa adanya untuk audit/replay.
  rawPayload Json
  createdAt  DateTime  @default(now())

  items TransactionItem[]

  @@index([memberId])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId String?
  name      String
  qty       Int
  unitPrice Int
  variant   String?
  addons    String[]
  notes     String?
  isReward  Boolean  @default(false)
  lineTotal Int

  @@index([transactionId])
  @@map("transaction_items")
}

// Ledger mutasi poin, append-only (§10 PRD).
model PointHistory {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  type          String // earn | redeem | adjust | reverse
  points        Int // signed: + earn, - redeem
  balanceAfter  Int
  referenceType String? // "transaction"
  referenceId   String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([memberId])
  @@map("point_histories")
}

// Audit setiap event POS yang diterima (termasuk duplikat & error).
model PosSyncLog {
  id             String   @id @default(cuid())
  eventId        String?
  idempotencyKey String
  status         String // received | processed | duplicate | invalid_signature | error
  errorMessage   String?
  rawPayload     Json
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
  @@map("pos_sync_logs")
}

// Permintaan login magic-link via WhatsApp. token dikirim user dalam pesan WA;
// inbound webhook menandai claimed + phone, lalu app menukar token jadi sesi.
model WaLoginRequest {
  id         String    @id @default(cuid())
  token      String    @unique
  phone      String?
  claimedAt  DateTime?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("wa_login_requests")
}

// ── Outlet ──────────────────────────────────────────────────────────────────

enum OutletStatus {
  ACTIVE
  INACTIVE
}

// Lokasi outlet POLKS. storeId memetakan ke POS store_id (untuk statistik &
// sinkronisasi per-outlet). GET /outlets publik hanya menampilkan ACTIVE.
model Outlet {
  id        String       @id @default(cuid())
  name      String
  city      String?
  address   String?
  hours     String?
  phone     String?
  status    OutletStatus @default(ACTIVE)
  storeId   String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("outlets")
}

// Konfigurasi loyalty global (singleton, id tetap "singleton"). rupiahPerPoint
// dipakai webhook untuk menghitung earning poin (fallback env POIN_PER_RUPIAH).
model LoyaltyConfig {
  id                     String   @id @default("singleton")
  rupiahPerPoint         Int      @default(1000)
  pointsPerUnit          Int      @default(1)
  pointExpiryMonths      Int?
  tierThresholds         Json     @default("[]")
  webhookUrl             String?
  requireIdempotencyKeys Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  @@map("loyalty_config")
}

// ── Promo ───────────────────────────────────────────────────────────────────

enum PromoStatus {
  ACTIVE
  INACTIVE
}

// Promo untuk ditampilkan ke customer. "Tampil" = status ACTIVE & sekarang
// berada dalam rentang startAt–endAt (null = tak dibatasi).
model Promo {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  startAt     DateTime?
  endAt       DateTime?
  status      PromoStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("promos")
}

// ── Reward, Voucher, Redeem ─────────────────────────────────────────────────

enum RewardStatus {
  ACTIVE
  INACTIVE
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
}

// Katalog reward yang bisa ditukar dengan poin.
model Reward {
  id          String       @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  pointCost   Int
  stock       Int          @default(0)
  status      RewardStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  vouchers Voucher[]
  redeems  Redeem[]

  @@map("rewards")
}

// Voucher hasil redeem — bukti tukar poin yang bisa dipakai pelanggan.
model Voucher {
  id        String        @id @default(cuid())
  code      String        @unique
  rewardId  String
  reward    Reward        @relation(fields: [rewardId], references: [id])
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id])
  status    VoucherStatus @default(ACTIVE)
  expiredAt DateTime?
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  redeem Redeem?

  @@index([memberId])
  @@map("vouchers")
}

// Histori redeem (poin keluar → voucher). 1 redeem = 1 voucher.
model Redeem {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id])
  voucherId   String   @unique
  voucher     Voucher  @relation(fields: [voucherId], references: [id])
  pointsSpent Int
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@map("redeems")
}
