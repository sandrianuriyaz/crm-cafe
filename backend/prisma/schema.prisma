generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// model contoh untuk verifikasi koneksi
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

// ── Auth & Account ──────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

// Akun login (customer & admin). Satu User customer terhubung ke satu Member
// (relasi 1:1 opsional). Admin tidak perlu Member.
model User {
  id           String   @id @default(cuid())
  name         String
  // Nullable: user yang daftar lewat OTP (phone) tidak punya email/password.
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         Role     @default(CUSTOMER)

  // 2FA berbasis TOTP (authenticator app). Saat setup, secret disimpan tapi
  // twoFactorEnabled tetap false sampai user verifikasi kode pertama (enable).
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  // Kode pemulihan sekali-pakai (disimpan sebagai hash bcrypt). Cadangan login
  // kalau aplikasi authenticator hilang. Dipakai → dihapus dari array.
  twoFactorRecoveryCodes String[] @default([])

  // Verifikasi email: false sampai user klik tautan verifikasi yang dikirim ke
  // emailnya. Login tetap boleh tanpa verifikasi (verifikasi bersifat informatif).
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  // Email baru menunggu konfirmasi lewat link (lihat AuthTokenType.EMAIL_CHANGE).
  // Tidak unique di level DB — dicek di level aplikasi, race ditangkap via
  // P2002 pada `email` (yang memang unique) saat konfirmasi.
  pendingEmail    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member               Member?
  authTokens           AuthToken[]
  notificationSettings NotificationSettings?

  @@map("users")
}

// Token sekali-pakai untuk reset password & verifikasi email. Hanya HASH yang
// disimpan (sha256) — token asli hanya ada di tautan email. usedAt != null atau
// expiresAt lewat = token tak berlaku.
enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
  EMAIL_CHANGE
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

// Preferensi notifikasi per akun (1:1 User). Baris dibuat lewat upsert saat
// pertama kali diakses/diubah; default semua aktif.
model NotificationSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Kanal pengiriman.
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(true)

  // Kategori konten.
  promoNotifications  Boolean @default(true)
  pointNotifications  Boolean @default(true)
  rewardNotifications Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// Tier keanggotaan (opsional, dipakai nanti untuk benefit per level poin).
model Tier {
  id        String   @id @default(cuid())
  name      String   @unique
  minPoints Int      @default(0)
  benefits  String?
  createdAt DateTime @default(now())

  members Member[]

  @@map("tiers")
}

// ── Integrasi POS Fase 1 (transaction.completed → CRM) ──────────────────────
// Lihat docs/integrasi-crm.md. CRM = source of truth saldo poin.

// Pelanggan CRM. Member (punya customer.id dari POS) maupun walk-in yang
// diidentifikasi via phone. Walk-in benar-benar anonim (id+phone null) TIDAK
// dibuatkan baris di sini — transaksinya tetap dicatat tanpa member (lihat §11 #4).
model Member {
  id                 String   @id @default(cuid())
  memberCode         String   @unique
  // customer.id dari POS dipakai sebagai external key (§11 #5).
  externalCustomerId String?  @unique
  name               String?
  phone              String?   @unique
  // Diisi manual (register email/password atau /complete-profile setelah
  // Google — Google OAuth tidak menyediakan tanggal lahir). Belum ada
  // reward/notifikasi otomatis berbasis field ini.
  birthDate          DateTime?
  pointBalance       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Akun login pemilik member (null = member dari POS yang belum punya akun /
  // belum diklaim lewat register by phone). Lihat alur klaim member.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  tierId String?
  tier   Tier?   @relation(fields: [tierId], references: [id])

  transactions   Transaction[]
  pointHistories PointHistory[]
  vouchers       Voucher[]
  redeems        Redeem[]
  notifications  Notification[]

  @@map("members")
}

// Pengumuman admin ke member (riwayat broadcast). Pengiriman = buat baris
// Notification untuk tiap member target (in-app).
model Broadcast {
  id             String   @id @default(cuid())
  title          String
  message        String
  imageUrl       String?
  target         String // all | silver | gold | platinum | inactive
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("broadcasts")
}

// Notifikasi in-app milik satu member (hasil broadcast). readAt null = belum dibaca.
model Notification {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id])
  title     String
  message   String
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId])
  @@map("notifications")
}

model Transaction {
  id             String  @id @default(cuid())
  // transaction.order_id dari POS; idempotency_key = order_id (§6).
  posOrderId     String? @unique
  posOrderNumber String?
  idempotencyKey String  @unique
  // event_id beda tiap retry — disimpan untuk audit, bukan kunci dedup.
  eventId        String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])

  storeId  String?
  branchId String?

  orderType String?
  status    String?
  cashierId String?
  currency  String? @default("IDR")

  subtotal             Int     @default(0)
  discountTotal        Int     @default(0)
  taxTotal             Int     @default(0)
  taxInclusive         Boolean @default(true)
  grandTotal           Int
  paymentMethod        String?
  pointsUsed           Int     @default(0)
  pointsDiscountRupiah Int     @default(0)

  // Poin yang di-award CRM untuk transaksi ini (earning).
  pointsAwarded Int @default(0)

  occurredAt DateTime?
  // Payload §4 mentah, disimpan apa adanya untuk audit/replay.
  rawPayload Json
  createdAt  DateTime  @default(now())

  items TransactionItem[]

  @@index([memberId])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId String?
  name      String
  qty       Int
  unitPrice Int
  variant   String?
  addons    String[]
  notes     String?
  isReward  Boolean  @default(false)
  lineTotal Int

  @@index([transactionId])
  @@map("transaction_items")
}

// Ledger mutasi poin, append-only (§10 PRD).
model PointHistory {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  type          String // earn | redeem | adjust | reverse
  points        Int // signed: + earn, - redeem
  balanceAfter  Int
  referenceType String? // "transaction"
  referenceId   String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([memberId])
  @@map("point_histories")
}

// Audit setiap event POS yang diterima (termasuk duplikat & error).
model PosSyncLog {
  id             String   @id @default(cuid())
  eventId        String?
  idempotencyKey String
  status         String // received | processed | duplicate | invalid_signature | error
  errorMessage   String?
  rawPayload     Json
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
  @@map("pos_sync_logs")
}

// ── Outlet ──────────────────────────────────────────────────────────────────

enum OutletStatus {
  ACTIVE
  INACTIVE
}

// Lokasi outlet POLKS. storeId memetakan ke POS store_id (untuk statistik &
// sinkronisasi per-outlet). GET /outlets publik hanya menampilkan ACTIVE.
model Outlet {
  id        String       @id @default(cuid())
  name      String
  city      String?
  address   String?
  hours     String?
  phone     String?
  status    OutletStatus @default(ACTIVE)
  storeId   String?      @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  promoOutlets  PromoOutlet[]
  rewardOutlets RewardOutlet[]

  @@map("outlets")
}

// Konfigurasi loyalty global (singleton, id tetap "singleton"). rupiahPerPoint
// dipakai webhook untuk menghitung earning poin (fallback env POIN_PER_RUPIAH).
model LoyaltyConfig {
  id                     String   @id @default("singleton")
  rupiahPerPoint         Int      @default(1000)
  pointsPerUnit          Int      @default(1)
  pointExpiryMonths      Int?
  tierThresholds         Json     @default("[]")
  webhookUrl             String?
  requireIdempotencyKeys Boolean  @default(true)

  // Tier berbasis belanja bulanan (Rp). Bronze = 0 (implisit).
  tierSilverMin   Int @default(500000)
  tierGoldMin     Int @default(1000000)
  tierPlatinumMin Int @default(1500000)
  // Rate earning per tier: Rp per 1 poin (makin kecil = makin banyak poin).
  rateBronze   Int @default(1000)
  rateSilver   Int @default(950)
  rateGold     Int @default(900)
  ratePlatinum Int @default(850)

  updatedAt DateTime @updatedAt

  @@map("loyalty_config")
}

// ── Promo ───────────────────────────────────────────────────────────────────

enum PromoStatus {
  ACTIVE
  INACTIVE
}

// Promo untuk ditampilkan ke customer. "Tampil" = status ACTIVE & sekarang
// berada dalam rentang startAt–endAt (null = tak dibatasi).
model Promo {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  startAt     DateTime?
  endAt       DateTime?
  status      PromoStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Tag outlet mana promo ini relevan (murni informasi admin — kosong berarti
  // berlaku/relevan di semua outlet; belum ada filter otomatis di customer/POS).
  outlets PromoOutlet[]

  @@map("promos")
}

// Baris relasi Promo ↔ Outlet (many-to-many eksplisit).
model PromoOutlet {
  id       String @id @default(cuid())
  promoId  String
  promo    Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([promoId, outletId])
  @@map("promo_outlets")
}

// ── Reward, Voucher, Redeem ─────────────────────────────────────────────────

enum RewardStatus {
  ACTIVE
  INACTIVE
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
}

// Efek reward saat voucher di-redeem (dibaca POS kasir).
// DISCOUNT_AMOUNT = potongan Rupiah (value=Rp), DISCOUNT_PERCENT = potongan
// persen 0-100 (value=%), FREE_ITEM = item gratis (freeItemName), MANUAL = hadiah
// fisik (value & freeItemName null).
enum RewardType {
  DISCOUNT_AMOUNT
  DISCOUNT_PERCENT
  FREE_ITEM
  MANUAL
}

// Katalog reward yang bisa ditukar dengan poin.
model Reward {
  id           String       @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  pointCost    Int
  stock        Int          @default(0)
  status       RewardStatus @default(ACTIVE)
  type         RewardType   @default(MANUAL)
  value        Int?
  // Minimal total belanja (Rp) agar diskon berlaku — informasi saja, dibaca
  // kasir/POS secara manual. Belum ada enforcement otomatis di server.
  minPurchase  Int?
  freeItemName String?
  // Periode tayang di katalog customer (null = tak dibatasi di sisi itu),
  // sejalan dengan Promo.startAt/endAt. Di luar rentang reward hilang dari
  // katalog tanpa perlu admin menonaktifkan manual.
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vouchers Voucher[]
  redeems  Redeem[]

  // Tag outlet mana reward ini relevan (murni informasi admin — kosong berarti
  // berlaku/relevan di semua outlet; belum ada filter otomatis di customer/POS).
  outlets RewardOutlet[]

  @@map("rewards")
}

// Baris relasi Reward ↔ Outlet (many-to-many eksplisit).
model RewardOutlet {
  id       String @id @default(cuid())
  rewardId String
  reward   Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([rewardId, outletId])
  @@map("reward_outlets")
}

// Voucher hasil redeem — bukti tukar poin yang bisa dipakai pelanggan.
model Voucher {
  id        String        @id @default(cuid())
  code      String        @unique
  rewardId  String
  reward    Reward        @relation(fields: [rewardId], references: [id])
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id])
  status    VoucherStatus @default(ACTIVE)
  expiredAt DateTime?
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  redeem Redeem?

  @@index([memberId])
  @@map("vouchers")
}

// Histori redeem (poin keluar → voucher). 1 redeem = 1 voucher.
model Redeem {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  rewardId    String
  reward      Reward   @relation(fields: [rewardId], references: [id])
  voucherId   String   @unique
  voucher     Voucher  @relation(fields: [voucherId], references: [id])
  pointsSpent Int
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@map("redeems")
}
