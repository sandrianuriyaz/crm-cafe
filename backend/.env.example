NODE_ENV=development
PORT=3000
DATABASE_URL=
DIRECT_URL=
# Opsional (belum dipakai). Boleh dikosongkan.
REDIS_URL=
JWT_SECRET=
# Origin frontend untuk CORS (pisah koma). Kosong = izinkan semua (dev).
# Production: isi domain Vercel, mis. https://polks.vercel.app
CORS_ORIGIN=

# Google OAuth (login via Google). Buat di Google Cloud Console → Credentials.
# Callback harus terdaftar di OAuth client: {API}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Login magic-link WhatsApp
# URL frontend untuk link balasan (mis. http://localhost:3001 / domain Vercel)
FRONTEND_URL=http://localhost:3001
# Nomor WhatsApp bisnis tujuan wa.me (angka saja). Kosong = pakai TWILIO_WHATSAPP_FROM
WHATSAPP_BUSINESS_NUMBER=
# Verifikasi X-Twilio-Signature inbound AKTIF default. Set 'false' HANYA di dev
# lokal (tanpa tunnel publik) untuk melewatinya. Production: biarkan kosong/true.
WHATSAPP_VERIFY_SIGNATURE=
# Opsional: override base URL publik untuk verifikasi signature (mis. https://api.polks.id)
PUBLIC_WEBHOOK_BASE_URL=

# Integrasi POS Fase 1
CRM_WEBHOOK_SECRET=
POIN_PER_RUPIAH=1000
POIN_NILAI_RUPIAH=1000

# OTP login (Twilio WhatsApp/SMS). Kosong = endpoint OTP menolak saat kirim.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
